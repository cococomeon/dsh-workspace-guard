{
  "name": "dsh-workspace-guard",
  "version": "0.1.0",
  "description": "Workspace occupancy, cleanliness, assignment and assign-time gating for the DeepSeek Harness: judge whether a workspace is busy or dirty, pick a free and clean one for a task, refuse a task whose assigned workspace is unusable, and record the workspace-to-session relation. LOCAL PLUGIN: built from ./src by ./build.mjs.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "zod": "^4.4.3"
  },
  "files": [
    "lib/**/*.js",
    "src",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs"
  }
}
